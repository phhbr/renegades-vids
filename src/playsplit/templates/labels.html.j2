<!doctype html>
<meta charset="utf-8">
<title>playsplit — label correction — {{ clip }}</title>
<style>
  :root { color-scheme: light dark; --bg:#fff; --fg:#111; --mut:#666; --line:#ddd; --card:#fafafa; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#131519; --fg:#e8e8ea; --mut:#9aa0a6; --line:#2c2f36; --card:#191c21; }
  }
  body { background:var(--bg); color:var(--fg); font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
         margin:0; padding:24px 28px; }
  h1 { font-size:20px; margin:0 0 4px; }
  .sub { color:var(--mut); margin-bottom:20px; }
  .how { background:var(--card); border:1px solid var(--line); border-radius:8px;
         padding:12px 16px; margin-bottom:24px; max-width:900px; }
  .how code { background:rgba(127,127,127,.16); padding:1px 5px; border-radius:4px; }
  .cand { border:1px solid var(--line); border-radius:8px; margin-bottom:18px; overflow:hidden; }
  .hd { display:flex; gap:18px; align-items:baseline; padding:10px 14px;
        background:var(--card); border-bottom:1px solid var(--line); flex-wrap:wrap; }
  .n { font-weight:700; font-size:15px; }
  .t { font-variant-numeric:tabular-nums; }
  .mut { color:var(--mut); }
  .shots { display:grid; grid-template-columns:repeat(3,1fr); gap:2px; background:var(--line); }
  .shot { position:relative; background:var(--bg); }
  .shot img { width:100%; display:block; }
  .tag { position:absolute; left:8px; top:8px; background:rgba(0,0,0,.72); color:#fff;
         font-size:11px; padding:2px 7px; border-radius:4px; letter-spacing:.02em; }
  .ts { position:absolute; right:8px; top:8px; background:rgba(0,0,0,.72); color:#fff;
        font-size:11px; padding:2px 7px; border-radius:4px; font-variant-numeric:tabular-nums; }
</style>

<h1>Label correction — {{ clip }}</h1>
<div class="sub">
  {{ candidates|length }} bootstrap candidates from whistle anchors ·
  clip duration {{ '%.1f'|format(duration) }} s ·
  play band native y {{ band.top }}–{{ band.bottom }}
</div>

<div class="how">
  <strong>How to correct:</strong> open <code>{{ label_file }}</code> next to this page.
  Each row matches a card below by <code>index</code>.
  <ul style="margin:8px 0 0 0; padding-left:20px;">
    <li>Not a play (warm-up, penalty admin, ref discussion)? Set <code>verdict</code> to <code>drop</code>.</li>
    <li>Play the whistle detector missed? Add a row — any <code>index</code>, it gets renumbered.</li>
    <li><code>end</code> is the whistle time and should already be close. <code>start</code> is a crude
        <code>whistle − {{ '%.0f'|format(lead) }} s</code> placeholder — that's the number worth fixing.</li>
  </ul>
</div>

{% for c in candidates %}
<div class="cand">
  <div class="hd">
    <span class="n">#{{ c.index }}</span>
    <span class="t">{{ '%.2f'|format(c.start) }} → {{ '%.2f'|format(c.end) }} s</span>
    <span class="t mut">{{ '%.1f'|format(c.end - c.start) }} s</span>
    <span class="mut">{{ c.notes }}</span>
  </div>
  <div class="shots">
    {% for shot in c.shots %}
    <div class="shot">
      <img src="{{ shot.src }}" loading="lazy" alt="{{ shot.label }}">
      <span class="tag">{{ shot.label }}</span>
      <span class="ts">{{ '%.1f'|format(shot.time) }}s</span>
    </div>
    {% endfor %}
  </div>
</div>
{% endfor %}
